root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs}]
indent_style = space
indent_size = 2
quote_type = single
continuation_indent_size = 2

[*.css]
indent_style = space
indent_size = 4

[*.html]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2
